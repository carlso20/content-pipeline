# ============================================================
# Content Pipeline - Environment Variables
# Copy to .env for local dev. On Railway, set these in the
# service's Variables panel. NEVER commit .env to git.
# ============================================================

# --- Core ---
PORT=8080
ENVIRONMENT=development          # development | production
DARK_LAUNCH_MODE=true            # true = simulate publishes; false = go live
POLL_INTERVAL_MINUTES=10         # How often to check YouTube for new uploads
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# --- Database (Railway Postgres plugin auto-sets DATABASE_URL) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- YouTube Data API v3 ---
# Create at: https://console.cloud.google.com/ → APIs & Services → Credentials
# Scope required: https://www.googleapis.com/auth/youtube.readonly
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- OpenAI (Phase 2+) ---
# Scope: standard API key with access to whisper-1 and gpt-4o
OPENAI_API_KEY=your_openai_api_key_here

# --- Buzzsprout (Phase 2+) ---
# Found at: https://www.buzzsprout.com/app/profile → API Credentials
# One token covers all shows; show IDs are per-brand in brand_config table
BUZZSPROUT_API_TOKEN=your_buzzsprout_api_token_here

# --- ClickUp ---
# Create at: https://app.clickup.com/settings/apps
# Scope: tasks:write, tasks:read, lists:read
CLICKUP_API_TOKEN=your_clickup_api_token_here
CLICKUP_APPROVAL_QUEUE_LIST_ID=901816948630

# --- Google Drive (Phase 2+ for transcript storage) ---
# Service account JSON key (base64-encoded for Railway env var safety)
# Scope: https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON_B64=base64_encoded_service_account_json

# --- Email Notifications (Roller/Gmail) ---
# Used for dark-launch payloads and failure alerts to Carl
NOTIFICATION_EMAIL_TO=cwleadlist@gmail.com
NOTIFICATION_EMAIL_FROM=your_sender@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# --- Brand-specific YouTube Channel IDs (OPTIONAL) ---
# If NOT set, seed_brand_config.py will auto-resolve them from YouTube channel
# handles using YOUTUBE_API_KEY at seed time. Just ensure YOUTUBE_API_KEY is
# valid and re-run: python scripts/seed_brand_config.py
#
# To override manually, resolve handles first:
#   python scripts/resolve_channel_ids.py
# Then paste the UCxxxxxxxx values here and re-run the seed script.
#
# YOUTUBE_CHANNEL_ID_REMODELING_MARKETING=UCnqpHHqgpvEs1wkfDMt95uA
# YOUTUBE_CHANNEL_ID_AGENT_BRANDING=UC_your_resolved_id_here
# YOUTUBE_CHANNEL_ID_CARL_WILLIS=UC_your_resolved_id_here

# --- Brand-specific Buzzsprout Show IDs (OPTIONAL) ---
# Default values are baked into seed_brand_config.py.
# Override here if your show IDs differ.
# BUZZSPROUT_SHOW_ID_REMODELING=2125225
# BUZZSPROUT_SHOW_ID_AGENT_BRANDING=2168365
# BUZZSPROUT_SHOW_ID_CARL_WILLIS=2511435

# --- Brand-specific CTAs and WordPress URLs (Phase 3+) ---
# CTA_URL_REMODELING=https://your-remodeling-landing-page.com
# CTA_URL_AGENT_BRANDING=https://your-agent-branding-landing-page.com
# CTA_URL_CARL_WILLIS=https://your-carl-willis-landing-page.com
# WORDPRESS_URL_REMODELING=https://your-remodeling-site.com
# WORDPRESS_URL_AGENT_BRANDING=https://your-agent-branding-site.com
# WORDPRESS_URL_CARL_WILLIS=https://your-carl-willis-site.com
